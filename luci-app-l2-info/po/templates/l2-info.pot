#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:37
msgid "No forwarding entries were reported. An idle bridge and a switch driver that does not report its hardware table look identical from a single read, so this is recorded as undetermined rather than empty."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:47
msgid "The forwarding database could not be read: %s"
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:61
msgid "Nothing installed on this device can read: %s. Installing a reader package adds that capability."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:75
msgid "No bridge on this device has VLAN filtering enabled, so the VLAN columns are empty because there are no VLANs to report. Either this device is not doing 802.1Q at all, or tagging happens at the interface layer with one bridge per VLAN — in which case the VLAN is in the interface name rather than in the forwarding table."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:89
msgid "%d of the addresses shown arrived untagged. The forwarding database records no VLAN for those, so the VLAN column shows the port's own native VLAN and is marked accordingly."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:106
msgid "%s has %d addresses behind it. That is usually an unmanaged switch or hub, but a hypervisor bridging guest machines or a desk phone with a PC passthrough port looks the same from here."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:128
msgid "%s carries %d VLANs and has no native VLAN, so everything on it is tagged. That shape is typical of a link to another managed switch, or of a single tagged link to a router."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:154
msgid "%d address(es) appear on more than one port: %s. A client that has just moved, a link aggregation, or a bridging loop all produce this."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:166
msgid "%d value(s) are reported differently by different readers and are shown as disputed rather than resolved. Nothing here picks a winner."
msgstr ""

#: luci-app-l2-info/htdocs/luci-static/resources/l2-info/hints.js:176
msgid "Host names are blank because this device has no DHCP leases and no /etc/ethers. That is normal on a switch; the names live wherever DHCP runs."
msgstr ""

